    {
      "id": "l1-long-comparison-decision",
      "title": "A distant first recommendation can be ratified",
      "tags": ["positive", "project", "long_range", "ratification"],
      "exchanges": [
        { "id": "l1-1", "user_message": "Which state manager fits this app?", "assistant_message": "I recommend Riverpod for this app." },
        { "id": "l1-2", "user_message": "What are its tradeoffs?", "assistant_message": "Riverpod is testable but adds providers." },
        { "id": "l1-3", "user_message": "Compare Bloc.", "assistant_message": "Bloc is another option with more boilerplate." },
        { "id": "l1-4", "user_message": "How about Provider?", "assistant_message": "Provider is simpler but less structured." },
        { "id": "l1-5", "user_message": "What about testing?", "assistant_message": "All three can be tested." },
        { "id": "l1-6", "user_message": "Summarize the constraints.", "assistant_message": "The original recommendation balances them best." },
        { "id": "l1-7", "user_message": "Any blocker?", "assistant_message": "No blocker." },
        { "id": "l1-8", "user_message": "그럼 처음 추천한 걸로 하자.", "assistant_message": "Riverpod으로 진행하겠습니다." }
      ],
      "expected": { "outcome": "facts", "facts": [{
        "required_terms": ["riverpod"],
        "category": "decision",
        "scope_type": "project",
        "authoritative_exchange_ids": ["l1-8"]
      }] }
    },
