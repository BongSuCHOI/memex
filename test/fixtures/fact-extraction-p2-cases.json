        { "id": "l3-3", "user_message": "Compare them.", "assistant_message": "Both satisfy the stated constraints." },
        { "id": "l3-4", "user_message": "그걸로 하자.", "assistant_message": "어느 것을 뜻하는지 확인이 필요합니다." }
      ],
      "expected": { "outcome": "none", "false_positive_taxonomy": "DROP-unsupported" }
