      "tags": ["positive", "global", "long_range", "style"],
      "exchanges": [
        { "id": "lg1-1", "user_message": "답변 스타일 몇 가지 보여줘.", "assistant_message": "A는 상세하고 B는 간결하며 C는 표 중심입니다." },
        { "id": "lg1-2", "user_message": "B가 낫네. 설명은 줄여줘.", "assistant_message": "간결한 설명으로 조정했습니다." },
        { "id": "lg1-3", "user_message": "예시는 조금 더 줘.", "assistant_message": "간결한 설명에 구체적인 예시를 추가했습니다." },
        { "id": "lg1-4", "user_message": "문단은 짧게.", "assistant_message": "짧은 문단과 구체적인 예시로 답하겠습니다." },
        { "id": "lg1-5", "user_message": "한번 적용해봐.", "assistant_message": "짧은 설명입니다. 예시: 입력과 출력을 함께 제시합니다." },
        { "id": "lg1-6", "user_message": "조금 더 자연스럽게.", "assistant_message": "짧고 자연스러운 설명과 예시를 제공합니다." },
        { "id": "lg1-7", "user_message": "지금 방식이 딱 좋네. 앞으로도 계속 이렇게 해줘.", "assistant_message": "앞으로 이 응답 스타일을 유지하겠습니다." }
      ],
      "expected": { "outcome": "facts", "facts": [{
        "required_terms": ["짧", "자연"],
        "category": "preference",
        "scope_type": "global",
        "authoritative_exchange_ids": ["lg1-7"]
      }] }
    },
