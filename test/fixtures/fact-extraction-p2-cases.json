        { "id": "l2-3", "user_message": "Show another option.", "assistant_message": "Option two is Bloc." },
        { "id": "l2-4", "user_message": "And another?", "assistant_message": "Option three is Provider." },
        { "id": "l2-5", "user_message": "Compare maintenance.", "assistant_message": "Each option has tradeoffs." },
        { "id": "l2-6", "user_message": "첫 번째 안으로 하자.", "assistant_message": "Riverpod으로 진행합니다." }
      ],
      "expected": { "outcome": "facts", "facts": [{
        "required_terms": ["riverpod"],
        "category": "decision",
        "scope_type": "project",
        "authoritative_exchange_ids": ["l2-6"]
      }] }
    },
