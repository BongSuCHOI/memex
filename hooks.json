{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-version-drift",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex sync --background",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-sync-import",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-maintenance",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-inject"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-session-end"
          }
        ]
      }
    ]
  }
}
