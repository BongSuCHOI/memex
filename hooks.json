{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-version-drift",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex sync --background",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-sync-import",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-maintenance",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-inject"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/runtime-exec.js\" memex-hook-continuity",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
