{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/version-drift-check.js\"",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/cli/memory-bank.js\" sync --background",
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-start-maintenance.js\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/inject-context-hook.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-end-hook.js\""
          }
        ]
      }
    ]
  }
}
