{
  "name": "memory-bank",
  "version": "1.5.0-codex.1",
  "description": "Semantic memory for Codex conversations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "memory-bank": "./cli/memory-bank.js",
    "memory-bank-index": "./cli/index-conversations.js",
    "memory-bank-search": "./cli/search-conversations",
    "memory-bank-mcp-server": "./cli/mcp-server"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --outfile=dist/mcp-server.js --external:fsevents --external:sharp --external:onnxruntime-node --external:better-sqlite3 --external:@xenova/transformers --external:sqlite-vec",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build"
  },
  "keywords": [
    "codex",
    "conversations",
    "search",
    "semantic-search",
    "embeddings"
  ],
  "author": {
    "name": "BongSuCHOI"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.4.1",
    "marked": "^16.4.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
